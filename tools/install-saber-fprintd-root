#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  echo "Run this helper through pkexec or sudo." >&2
  exit 1
fi

package=${1:?usage: install-saber-fprintd-root PACKAGE BLOB_DIRECTORY}
blob_source=${2:?usage: install-saber-fprintd-root PACKAGE BLOB_DIRECTORY}
blob_target=/var/lib/libfprint/syna0082

for name in config-06.bin scan-matrix-02.bin; do
  if [[ ! -f "$blob_source/$name" ]]; then
    echo "Missing required blob: $blob_source/$name" >&2
    exit 1
  fi
done

# Keep this interactive: a first installation may need explicit approval to
# replace an existing libfprint or libfprint-git package.  Running pacman with
# --noconfirm answers that conflict prompt with its safe default and leaves a
# misleading half-installed blob directory behind.
pacman -U "$package"

install -d -o root -g root -m 0700 "$blob_target"
for name in config-06.bin scan-matrix-02.bin; do
  install -o root -g root -m 0600 "$blob_source/$name" "$blob_target/$name"
done

systemctl try-restart fprintd.service
